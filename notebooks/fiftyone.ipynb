    "import fiftyone as fo\n",
    "import fiftyone.brain as fob\n",
    "import fiftyone.zoo as foz\n",
    "\n",
    "dataset = foz.load_zoo_dataset(\"quickstart\")\n",
    "\n",
    "# Image embeddings\n",
    "fob.compute_visualization(dataset, brain_key=\"img_viz\")\n"
   ]
